# Copy to .env (never commit .env). Every key is optional: without them the site falls back to
# the browser's own speech and a small local router.

# Sarvam AI: agent voices (Bulbul v3), speech-to-text (Saaras) and narration translation.
SARVAM_API_KEY=

# The agents' brain: Groq running GPT-OSS 120B (falls back to GPT-OSS 20B on rate limits).
GROQ_API_KEY=
# Or xAI Grok instead:
# LLM_PROVIDER=xai
# XAI_API_KEY=
# Optional model override, comma separated, tried in order (default: openai/gpt-oss-120b,openai/gpt-oss-20b)
# LLM_MODEL=openai/gpt-oss-120b

# Speech-to-text tuning (matches the production voice agents)
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=codemix

# Abuse protection for free tiers
# DAILY_LIMIT=3000
# Origins allowed to call the API when it runs on another host (comma separated)
# ALLOWED_ORIGINS=https://your-portfolio-domain.com

# Only for a separate API host without a proxy (build-time, read by the site)
# VITE_API_BASE=https://your-api-host.example.com
